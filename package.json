{
  "name": "perch",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --watch apps/server/src/index.ts",
    "dev:web": "bun run --filter @perch/web dev",
    "start": "bun apps/server/src/index.ts",
    "start:local": "bun run build && bun run start",
    "build": "bun run --filter @perch/web build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:changed": "biome check --changed",
    "db:generate": "bun run --filter @perch/server db:generate",
    "cli:build": "bun run --filter @perch/cli build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  }
}
