PERCH_TOKEN=change-me
PERCH_DB_PATH=./data/perch.db
PERCH_UPLOAD_DIR=./data/uploads
# PERCH_WEB_DIST=./apps/web/dist   (default: the built app in apps/web/dist)
PERCH_SECURE_COOKIES=true
PORT=3000

# CLI only: where `perch` keeps its config (default: ~/.perch/config.json)
# PERCH_CONFIG_PATH=/Users/you/.perch/config.json

# X OAuth "Web App" client from console.x.com; callback is <PERCH_PUBLIC_URL>/auth/x/callback
PERCH_X_CLIENT_ID=
PERCH_X_CLIENT_SECRET=
PERCH_PUBLIC_URL=http://127.0.0.1:3000

# Time zone seeded into Settings on the first boot (IANA name); Settings wins after that
PERCH_TIMEZONE=UTC

# Cloudflare R2 (task #24): Litestream streams the database here and every upload is copied here. Set all four or none.
PERCH_R2_ACCOUNT_ID=
PERCH_R2_BUCKET=
PERCH_R2_ACCESS_KEY_ID=
PERCH_R2_SECRET_ACCESS_KEY=

# Set to true for one deploy to restore /data from R2 (docs/runbooks/restore.md). Read by docker/start.sh only.
PERCH_RESTORE_FROM_R2=false
